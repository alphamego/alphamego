            local PatternIcon = Library:GetCustomIcon(WindowInfo.Icon)
            if PatternIcon then
                local PatternLayer = New("Frame", {
                    BackgroundTransparency = 1,
                    ClipsDescendants = true,
                    Size = UDim2.fromScale(1, 1),
                    ZIndex = 1,
                    Parent = Container,
                })
                local PatternCanvas = New("Frame", {
                    BackgroundTransparency = 1,
                    ZIndex = 1,
                    Parent = PatternLayer,
                })
                local PatternTileSize = 0
                local PatternColumns = 0
                local PatternRows = 0
                local PatternStartColumn = 0
                local PatternStartRow = 0
                local PatternStartedAt = os.clock()

                local function RefreshIconPattern()
                    local CanvasSize = PatternLayer.AbsoluteSize
                    if CanvasSize.X <= 0 or CanvasSize.Y <= 0 then
                        CanvasSize = Vector2.new(
                            math.max(WindowInfo.Size.X.Offset - InitialLeftWidth - 1, 1),
                            math.max(WindowInfo.Size.Y.Offset - 21, 1)
                        )
                    end

                    local TileSize = 110
                    local StartColumn = math.floor(PatternLayer.AbsolutePosition.X / TileSize) - 2
                    local StartRow = math.floor(PatternLayer.AbsolutePosition.Y / TileSize) - 2
                    local Columns = math.ceil(CanvasSize.X / TileSize) + 4
                    local Rows = math.ceil(CanvasSize.Y / TileSize) + 4
                    if TileSize == PatternTileSize
                        and Columns == PatternColumns
                        and Rows == PatternRows
                        and StartColumn == PatternStartColumn
                        and StartRow == PatternStartRow then
                        return
                    end

                    PatternTileSize = TileSize
                    PatternColumns = Columns
                    PatternRows = Rows
                    PatternStartColumn = StartColumn
                    PatternStartRow = StartRow
                    local IconSize = math.floor(TileSize * 0.52)

                    PatternCanvas:ClearAllChildren()
                    PatternCanvas.Size = UDim2.fromOffset(Columns * TileSize, Rows * TileSize)

                    for Row = 0, Rows - 1 do
                        for Column = 0, Columns - 1 do
                            New("ImageLabel", {
                                AnchorPoint = Vector2.new(0.5, 0.5),
                                Image = PatternIcon.Url,
                                ImageColor3 = PatternIcon.Custom and "WhiteColor" or "AccentColor",
                                ImageRectOffset = PatternIcon.ImageRectOffset,
                                ImageRectSize = PatternIcon.ImageRectSize,
                                ImageTransparency = WindowInfo.AnimatedIconBackgroundTransparency,
                                Position = UDim2.fromOffset(
                                    Column * TileSize,
                                    Row * TileSize
                                ),
                                Size = UDim2.fromOffset(IconSize, IconSize),
                                ZIndex = 1,
                                Parent = PatternCanvas,
                            })
                        end
                    end

                end

                Library:GiveSignal(PatternLayer:GetPropertyChangedSignal("AbsoluteSize"):Connect(RefreshIconPattern))

                Library:GiveSignal(RunService.RenderStepped:Connect(function()
                    if PatternTileSize <= 0 then
                        return
                    end

                    RefreshIconPattern()
                    local Distance = ((os.clock() - PatternStartedAt) / WindowInfo.AnimatedIconBackgroundSpeed)
                        * PatternTileSize
                    local Offset = Distance % PatternTileSize
                    local LayerPosition = PatternLayer.AbsolutePosition
                    PatternCanvas.Position = UDim2.fromOffset(
                        PatternStartColumn * PatternTileSize + Offset - LayerPosition.X,
                        PatternStartRow * PatternTileSize + Offset - LayerPosition.Y
                    )
                end))
                task.defer(RefreshIconPattern)
            end
        end
    end

