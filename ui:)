        Tabs.Size = UDim2.new(0, Width, 1, -114)
        Container.Size = UDim2.new(1, -Width - 1, 1, -21)

        if WindowInfo.EnableCompacting then
            ApplyCompact()
        end
        if not IsCompact then
            LastExpandedWidth = Width
        end
    end

