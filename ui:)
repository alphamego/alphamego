local Chaos = {}
Chaos.Library   = Library
Chaos.Flags     = {}
Chaos.SetFlags  = {}          -- config hooks the script writes into
Chaos._elements = {}          -- flag -> wrapper
Chaos._deps     = {}          -- depends-on flag -> { wrapper, ... }

local uidCounter = 0
local function uid(flag)
    if type(flag) == "string" and flag ~= "" then return flag end
    uidCounter += 1
    return "__chaos_" .. uidCounter
end

-- Callbacks run synchronously on purpose. The script guards its own
-- re-entrancy with the "Updating = true / Set() / Updating = false" pattern,
-- which only holds if the callback fires inside the Set() call.
local function safecall(fn, ...)
    if type(fn) ~= "function" then return end
    local ok, err = pcall(fn, ...)
    if not ok then warn("[chaos] callback error:", err) end
end

-- for callbacks that are fire-and-forget and may yield (server hops, HTTP)
local function spawncall(fn, ...)
    if type(fn) ~= "function" then return end
    local args = table.pack(...)
    task.spawn(function()
        local ok, err = pcall(fn, table.unpack(args, 1, args.n))
        if not ok then warn("[chaos] callback error:", err) end
    end)
end

local function keyString(default)
    if typeof(default) == "EnumItem" then
        local ok, str = pcall(function() return Library:GetKeyString(default) end)
        if ok and str then return str end
        return default.Name
    end
    if type(default) == "string" then return default end
    return "None"
end

local function decimalsOf(step)
    step = tonumber(step)
    if not step or step <= 0 then return 0 end
    if step >= 1 then return 0 end
    local s = string.format("%.6f", step):gsub("0+$", "")
    local dot = string.find(s, "%.")
    if not dot then return 0 end
    return math.min(#s - dot, 3)
end

-- Obsidian hands multi-dropdown values back as a set { [value] = true }.
-- The script iterates them with ipairs, so hand it a hybrid table that is
-- both an array and keyed by value.
local function multiToHybrid(value)
    local arr = {}
    if type(value) ~= "table" then return arr end
    for k, v in pairs(value) do
        if v == true and type(k) == "string" then
            table.insert(arr, k)
        end
    end
    table.sort(arr)
    for _, v in ipairs(arr) do arr[v] = true end
    return arr
end

function Chaos:_setFlag(flag, value)
    if type(flag) ~= "string" then return end
    self.Flags[flag] = value
    local deps = self._deps[flag]
    if not deps then return end
    local on = value and true or false
    for _, w in ipairs(deps) do
        if w._setDisabled then w:_setDisabled(not on) end
    end
end

function Chaos:_registerDepend(w, dependsOn)
    if type(dependsOn) ~= "string" then return end
    self._deps[dependsOn] = self._deps[dependsOn] or {}
    table.insert(self._deps[dependsOn], w)
    -- apply immediately in case the parent flag already exists
    if w._setDisabled then
        w:_setDisabled(not (self.Flags[dependsOn] and true or false))
    end
end

function Chaos:SetToggleGroupValue(flag, value)
    local w = self._elements[flag]
    if w and w.Set then w:Set(value) end
end

function Chaos:GetFlag(flag) return self.Flags[flag] end

--==================================================================
-- wrapper base
--==================================================================
local function newWrapper(obj, cfg)
    local w = {
        Object = obj,
        Flag   = cfg.Flag,
        Name   = cfg.Name,
        _inCallback = false,
    }

    if obj and obj.SetDisabled then
        function w:_setDisabled(disabled)
            pcall(function() self.Object:SetDisabled(disabled and true or false) end)
        end
    end

    if cfg.Flag then Chaos._elements[cfg.Flag] = w end
    return w
end

-- guards a script callback so an element setting its own value from inside
-- its own callback cannot recurse forever
local function guarded(w, fn, transform)
    return function(value)
        if transform then value = transform(value) end
        Chaos:_setFlag(w.Flag, value)
        if w._inCallback then return end
        w._inCallback = true
        local ok, err = pcall(fn, value)
        w._inCallback = false
        if not ok then warn("[chaos] callback error:", err) end
    end
end

