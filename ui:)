--==================================================================
-- LABEL ( + colorpicker )
--==================================================================
function SectionProto:Label(cfg)
    cfg = cfg or {}
    local label = self.Box:AddLabel(tostring(cfg.Name or ""))
    local w = newWrapper(label, cfg)

    function w:SetText(text) pcall(function() self.Object:SetText(tostring(text)) end) end

    function w:Colorpicker(pcfg)
        pcfg = pcfg or {}
        local cw
        local picker = self.Object:AddColorPicker(uid(pcfg.Flag), {
            Title    = tostring(pcfg.Name or "color"),
            Default  = (typeof(pcfg.Default) == "Color3") and pcfg.Default or Library.Scheme.AccentColor,
            Callback = function(color)
                if cw then Chaos:_setFlag(cw.Flag, color) end
                safecall(pcfg.Callback, color)
            end,
        })
        cw = newWrapper(picker, pcfg)
        function cw:Set(color)
            if typeof(color) ~= "Color3" then return end
            pcall(function() self.Object:SetValueRGB(color) end)
        end
        function cw:Get() return self.Object.Value end
        Chaos:_setFlag(pcfg.Flag, picker.Value)
        return cw
    end

    return w
end

function SectionProto:Colorpicker(cfg)
    return self:Label({ Name = cfg and cfg.Name or "color" }):Colorpicker(cfg)
end

--==================================================================
-- LIST  (custom widget - Obsidian has no scrolling list)
--==================================================================
function SectionProto:List(cfg)
    cfg = cfg or {}
    local container = self.Box.Container
    local height   = tonumber(cfg.Height) or 140
    local hasSearch = cfg.Search and true or false
    local selectable = cfg.Selectable ~= false
    local wrapped  = cfg.TextWrapped and true or false
    local multi    = cfg.Multi and true or false

    local w = { Flag = cfg.Flag, Name = cfg.Name, Multi = multi, Data = {} }
    w.Value = multi and {} or nil
    if cfg.Flag then Chaos._elements[cfg.Flag] = w end

    local titleH = cfg.Name and 18 or 0
    local searchH = hasSearch and 26 or 0

    local holder = Instance.new("Frame")
    holder.BackgroundTransparency = 1
    holder.BorderSizePixel = 0
    holder.Size = UDim2.new(1, 0, 0, height + titleH + searchH)
    holder.Parent = container

    if cfg.Name then
        local title = Instance.new("TextLabel")
        title.BackgroundTransparency = 1
        title.Size = UDim2.new(1, 0, 0, 16)
        title.FontFace = Library.Scheme.Font
        title.Text = tostring(cfg.Name)
        title.TextColor3 = Library.Scheme.FontColor
        title.TextSize = 14
        title.TextXAlignment = Enum.TextXAlignment.Left
        title.Parent = holder
        Library:AddToRegistry(title, { TextColor3 = "FontColor", FontFace = "Font" })
    end

    local searchBox
    if hasSearch then
        local sb = Instance.new("TextBox")
        sb.BackgroundColor3 = Library.Scheme.MainColor
        sb.BorderSizePixel = 0
        sb.Position = UDim2.fromOffset(0, titleH)
        sb.Size = UDim2.new(1, 0, 0, 22)
        sb.FontFace = Library.Scheme.Font
        sb.PlaceholderText = "search..."
        sb.Text = ""
        sb.TextColor3 = Library.Scheme.FontColor
        sb.TextSize = 13
        sb.ClearTextOnFocus = false
        sb.Parent = holder
        Library:AddToRegistry(sb, { BackgroundColor3 = "MainColor", TextColor3 = "FontColor", FontFace = "Font" })
        Library:AddOutline(sb)

        local pad = Instance.new("UIPadding")
        pad.PaddingLeft = UDim.new(0, 6)
        pad.Parent = sb
        searchBox = sb
    end

    local scroll = Instance.new("ScrollingFrame")
    scroll.BackgroundColor3 = Library.Scheme.MainColor
    scroll.BorderSizePixel = 0
    scroll.Position = UDim2.fromOffset(0, titleH + searchH)
    scroll.Size = UDim2.new(1, 0, 0, height)
    scroll.CanvasSize = UDim2.new()
    scroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
    scroll.ScrollBarThickness = 3
    scroll.ScrollBarImageColor3 = Library.Scheme.AccentColor
    scroll.ScrollingDirection = Enum.ScrollingDirection.Y
    scroll.Parent = holder
    Library:AddToRegistry(scroll, { BackgroundColor3 = "MainColor", ScrollBarImageColor3 = "AccentColor" })
    Library:AddOutline(scroll)

    local layout = Instance.new("UIListLayout")
    layout.SortOrder = Enum.SortOrder.LayoutOrder
    layout.Padding = UDim.new(0, tonumber(cfg.Padding) or 2)
    layout.Parent = scroll

    local pad = Instance.new("UIPadding")
    pad.PaddingTop = UDim.new(0, 4)
    pad.PaddingBottom = UDim.new(0, 4)
    pad.PaddingLeft = UDim.new(0, 4)
    pad.PaddingRight = UDim.new(0, 4)
    pad.Parent = scroll

    -- the script reaches into List.Items.Holder.Instance for the canvas
    w.Holder = { Instance = scroll }
    w.Items  = { Holder = w.Holder, Instance = scroll }
    w.Instance = holder

    local rows = {}

    local function isSelected(text)
        if multi then
            for _, v in ipairs(w.Value or {}) do if v == text then return true end end
            return false
        end
        return w.Value == text
    end

    local function paint()
        for _, row in ipairs(rows) do
            local sel = isSelected(row.Value)
            row.Button.BackgroundTransparency = sel and 0.78 or 1
            row.Button.TextColor3 = sel and ACCENT_LIT or Library.Scheme.FontColor
            row.Button.TextTransparency = w._disabled and 0.5 or 0
        end
    end

    local function rebuild()
        for _, row in ipairs(rows) do row.Button:Destroy() end
        table.clear(rows)

        local filter = searchBox and string.lower(searchBox.Text) or ""
        local order = 0
        for _, item in ipairs(w.Data) do
            local str = tostring(item)
            if filter == "" or string.find(string.lower(str), filter, 1, true) then
                order += 1
                local b = Instance.new("TextButton")
                b.AutoButtonColor = false
                b.BackgroundColor3 = Library.Scheme.AccentColor
                b.BackgroundTransparency = 1
                b.BorderSizePixel = 0
                b.LayoutOrder = order
                b.Size = UDim2.new(1, 0, 0, wrapped and 0 or 18)
                b.AutomaticSize = wrapped and Enum.AutomaticSize.Y or Enum.AutomaticSize.None
                b.FontFace = Library.Scheme.Font
                b.Text = str
                b.TextColor3 = Library.Scheme.FontColor
                b.TextSize = 13
                b.TextWrapped = wrapped
                b.TextXAlignment = cfg.Alignment or Enum.TextXAlignment.Left
                b.TextYAlignment = cfg.TextYAlignment or Enum.TextYAlignment.Center
                b.TextTruncate = wrapped and Enum.TextTruncate.None or Enum.TextTruncate.AtEnd
                b.RichText = false
                b.Parent = scroll

                local bp = Instance.new("UIPadding")
                bp.PaddingLeft = UDim.new(0, 6)
                bp.PaddingRight = UDim.new(0, 6)
                bp.Parent = b

                local bc = Instance.new("UICorner")
                bc.CornerRadius = UDim.new(0, 4)
                bc.Parent = b

                if selectable then
                    b.MouseEnter:Connect(function()
                        if not isSelected(str) then b.TextColor3 = ACCENT_LIT end
                    end)
                    b.MouseLeave:Connect(function()
                        if not isSelected(str) then b.TextColor3 = Library.Scheme.FontColor end
                    end)
                    b.MouseButton1Click:Connect(function()
                        if w._disabled then return end
                        if multi then
                            w.Value = w.Value or {}
                            local found
                            for i, v in ipairs(w.Value) do
                                if v == str then found = i break end
                            end
                            if found then table.remove(w.Value, found) else table.insert(w.Value, str) end
                        else
                            w.Value = str
                        end
                        Chaos:_setFlag(w.Flag, w.Value)
                        paint()
                        safecall(cfg.Callback, w.Value)
                    end)
                end

                table.insert(rows, { Button = b, Value = str })
            end
        end
        paint()
    end

    if searchBox then
        searchBox:GetPropertyChangedSignal("Text"):Connect(rebuild)
    end

    function w:Refresh(items)
        self.Data = {}
        for i, v in ipairs(items or {}) do self.Data[i] = v end

        if self.Multi then
            local keep = {}
            for _, v in ipairs(self.Value or {}) do
                for _, it in ipairs(self.Data) do
                    if tostring(it) == v then table.insert(keep, v) break end
                end
            end
            self.Value = keep
        else
            local still = false
            for _, it in ipairs(self.Data) do
                if tostring(it) == self.Value then still = true break end
            end
            if not still then self.Value = nil end
        end
        rebuild()
    end

    function w:Set(value)
        self.Value = value
        Chaos:_setFlag(self.Flag, value)
        paint()
    end

    function w:Get() return self.Value end

    function w:_setDisabled(disabled)
        self._disabled = disabled and true or false
        scroll.BackgroundTransparency = self._disabled and 0.5 or 0
        if searchBox then
            searchBox.TextEditable = not self._disabled
            searchBox.TextTransparency = self._disabled and 0.5 or 0
        end
        for _, row in ipairs(rows) do
            row.Button.TextTransparency = self._disabled and 0.5 or 0
        end
    end

    w:Refresh(cfg.Items or {})
    Chaos:_setFlag(cfg.Flag, w.Value)
    Chaos:_registerDepend(w, cfg.DependsOn)
    pcall(function() self.Box:Resize() end)
    return w
end

--==================================================================
-- NOTIFICATION
--==================================================================
-- Note: the table form of Library:Notify does tostring(Info.Title), which
-- renders a literal "nil" header when no title is passed, so use the vararg
-- form. A colour argument is only ever used to flag danger, and the scheme's
-- red already reads that way.
function Chaos:Notification(text, duration, color)
    pcall(function()
        Library:Notify(tostring(text), tonumber(duration) or 3)
    end)
end

Chaos.Notify = Chaos.Notification

--==================================================================
-- VIEWPORT WINDOW  (standalone floating panel)
--==================================================================
function Chaos:ViewportWindow(cfg)
    cfg = cfg or {}
    local obj = { Visible = false }

    local root = Instance.new("Frame")
    root.Name = "ChaosViewport"
    root.BackgroundColor3 = Library.Scheme.BackgroundColor
    root.BorderSizePixel = 0
    root.Position = cfg.Position or UDim2.fromOffset(60, 60)
    root.Size = cfg.Size or UDim2.fromOffset(315, 335)
    root.Visible = cfg.Visible and true or false
    root.ClipsDescendants = true
    root.ZIndex = 5
    root.Parent = Library.ScreenGui
    Library:AddToRegistry(root, { BackgroundColor3 = "BackgroundColor" })
    Library:AddOutline(root)

    local bar = Instance.new("Frame")
    bar.BackgroundColor3 = Library.Scheme.MainColor
    bar.BorderSizePixel = 0
    bar.Size = UDim2.new(1, 0, 0, 26)
    bar.ZIndex = 6
    bar.Parent = root
    Library:AddToRegistry(bar, { BackgroundColor3 = "MainColor" })

    local accent = Instance.new("Frame")
    accent.BackgroundColor3 = Library.Scheme.AccentColor
    accent.BorderSizePixel = 0
    accent.Position = UDim2.new(0, 0, 1, -1)
    accent.Size = UDim2.new(1, 0, 0, 1)
    accent.ZIndex = 7
    accent.Parent = bar
    Library:AddToRegistry(accent, { BackgroundColor3 = "AccentColor" })

    local grad = Instance.new("UIGradient")
    grad.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, ACCENT_HOT),
        ColorSequenceKeypoint.new(0.5, Library.Scheme.AccentColor),
        ColorSequenceKeypoint.new(1, ACCENT_LIT),
    })
    grad.Parent = accent

    local title = Instance.new("TextLabel")
    title.BackgroundTransparency = 1
    title.Position = UDim2.fromOffset(10, 0)
    title.Size = UDim2.new(1, -40, 1, 0)
    title.FontFace = Library.Scheme.Font
    title.Text = tostring(cfg.Name or "viewport")
    title.TextColor3 = Library.Scheme.FontColor
    title.TextSize = 13
    title.TextXAlignment = Enum.TextXAlignment.Left
    title.TextTruncate = Enum.TextTruncate.AtEnd
    title.ZIndex = 7
    title.Parent = bar
    Library:AddToRegistry(title, { TextColor3 = "FontColor", FontFace = "Font" })

    local close = Instance.new("TextButton")
    close.AutoButtonColor = false
    close.BackgroundTransparency = 1
    close.AnchorPoint = Vector2.new(1, 0.5)
    close.Position = UDim2.new(1, -8, 0.5, 0)
    close.Size = UDim2.fromOffset(18, 18)
    close.FontFace = Library.Scheme.Font
    close.Text = "X"
    close.TextColor3 = Library.Scheme.FontColor
    close.TextSize = 12
    close.ZIndex = 7
    close.Parent = bar
    close.MouseEnter:Connect(function() close.TextColor3 = ACCENT_HOT end)
    close.MouseLeave:Connect(function() close.TextColor3 = Library.Scheme.FontColor end)

    local viewport = Instance.new("ViewportFrame")
    viewport.BackgroundColor3 = Color3.fromRGB(17, 11, 9)
    viewport.BorderSizePixel = 0
    viewport.Position = UDim2.fromOffset(6, 32)
    viewport.Size = UDim2.new(1, -12, 1, -38)
    viewport.Ambient = Color3.fromRGB(190, 150, 132)
    viewport.LightColor = Color3.fromRGB(255, 192, 152)
    viewport.LightDirection = Vector3.new(-0.4, -1, -0.6)
    viewport.Active = true
    viewport.ZIndex = 6
    viewport.Parent = root
    Library:AddOutline(viewport)

    local world = Instance.new("WorldModel")
    world.Parent = viewport

    local cam = Instance.new("Camera")
    cam.FieldOfView = 55
    cam.Parent = viewport
    viewport.CurrentCamera = cam

    pcall(function() Library:MakeDraggable(root, bar, true, false) end)

    obj.Instance = root
    obj.Items = {
        Viewport = { Instance = viewport },
        Camera   = { Instance = cam },
        World    = { Instance = world },
        Title    = { Instance = title },
    }

    function obj:SetTitle(text) title.Text = tostring(text or "") end

    -- empties the world model; without this the cloned characters stack up
    -- every time the viewed player changes
    function obj:Clear()
        for _, child in ipairs(world:GetChildren()) do
            pcall(function() child:Destroy() end)
        end
    end
    function obj:SetVisible(v)
        root.Visible = v and true or false
        self.Visible = root.Visible
    end
    function obj:Destroy() root:Destroy() end

    close.MouseButton1Click:Connect(function() obj:SetVisible(false) end)
    return obj
end

