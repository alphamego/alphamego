function SectionProto:List(cfg)
    cfg = cfg or {}
    local container = self.Box.Container
    local height   = tonumber(cfg.Height) or 140
    local hasSearch = cfg.Search and true or false
    local selectable = cfg.Selectable ~= false
    local wrapped  = cfg.TextWrapped and true or false
    local multi    = cfg.Multi and true or false

    local w = { Flag = cfg.Flag, Name = cfg.Name, Multi = multi, Data = {} }
    w.Value = multi and {} or nil
    if cfg.Flag then Chaos._elements[cfg.Flag] = w end

    local titleH = cfg.Name and 18 or 0
    local searchH = hasSearch and 26 or 0

    local holder = Instance.new("Frame")
    holder.BackgroundTransparency = 1
    holder.BorderSizePixel = 0
    holder.Size = UDim2.new(1, 0, 0, height + titleH + searchH)
    holder.Parent = container

    if cfg.Name then
        local title = Instance.new("TextLabel")
        title.BackgroundTransparency = 1
        title.Size = UDim2.new(1, 0, 0, 16)
        title.FontFace = Library.Scheme.Font
        title.Text = tostring(cfg.Name)
        title.TextColor3 = Library.Scheme.FontColor
        title.TextSize = 14
        title.TextXAlignment = Enum.TextXAlignment.Left
        title.Parent = holder
        Library:AddToRegistry(title, { TextColor3 = "FontColor", FontFace = "Font" })
    end

    local searchBox
    if hasSearch then
        local sb = Instance.new("TextBox")
        sb.BackgroundColor3 = Library.Scheme.MainColor
        sb.BorderSizePixel = 0
        sb.Position = UDim2.fromOffset(0, titleH)
        sb.Size = UDim2.new(1, 0, 0, 22)
        sb.FontFace = Library.Scheme.Font
        sb.PlaceholderText = "search..."
        sb.Text = ""
        sb.TextColor3 = Library.Scheme.FontColor
        sb.TextSize = 13
        sb.ClearTextOnFocus = false
        sb.Parent = holder
        Library:AddToRegistry(sb, { BackgroundColor3 = "MainColor", TextColor3 = "FontColor", FontFace = "Font" })
        Library:AddOutline(sb)

        local pad = Instance.new("UIPadding")
        pad.PaddingLeft = UDim.new(0, 6)
        pad.Parent = sb
        searchBox = sb
    end

    local scroll = Instance.new("ScrollingFrame")
    scroll.BackgroundColor3 = Library.Scheme.MainColor
    scroll.BorderSizePixel = 0
    scroll.Position = UDim2.fromOffset(0, titleH + searchH)
    scroll.Size = UDim2.new(1, 0, 0, height)
    scroll.CanvasSize = UDim2.new()
    scroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
    scroll.ScrollBarThickness = 3
    scroll.ScrollBarImageColor3 = Library.Scheme.AccentColor
    scroll.ScrollingDirection = Enum.ScrollingDirection.Y
    scroll.Parent = holder
    Library:AddToRegistry(scroll, { BackgroundColor3 = "MainColor", ScrollBarImageColor3 = "AccentColor" })
    Library:AddOutline(scroll)

    local layout = Instance.new("UIListLayout")
    layout.SortOrder = Enum.SortOrder.LayoutOrder
    layout.Padding = UDim.new(0, tonumber(cfg.Padding) or 2)
    layout.Parent = scroll

    local pad = Instance.new("UIPadding")
    pad.PaddingTop = UDim.new(0, 4)
    pad.PaddingBottom = UDim.new(0, 4)
    pad.PaddingLeft = UDim.new(0, 4)
    pad.PaddingRight = UDim.new(0, 4)
    pad.Parent = scroll

    -- the script reaches into List.Items.Holder.Instance for the canvas
    w.Holder = { Instance = scroll }
    w.Items  = { Holder = w.Holder, Instance = scroll }
    w.Instance = holder

    local rows = {}

    local function isSelected(text)
        if multi then
            for _, v in ipairs(w.Value or {}) do if v == text then return true end end
            return false
        end
        return w.Value == text
    end

    local function paint()
        for _, row in ipairs(rows) do
            local sel = isSelected(row.Value)
            row.Button.BackgroundTransparency = sel and 0.78 or 1
            row.Button.TextColor3 = sel and ACCENT_LIT or Library.Scheme.FontColor
            row.Button.TextTransparency = w._disabled and 0.5 or 0
        end
    end

    local function rebuild()
        for _, row in ipairs(rows) do row.Button:Destroy() end
        table.clear(rows)

        local filter = searchBox and string.lower(searchBox.Text) or ""
        local order = 0
        for _, item in ipairs(w.Data) do
            local str = tostring(item)
            if filter == "" or string.find(string.lower(str), filter, 1, true) then
                order += 1
                local b = Instance.new("TextButton")
                b.AutoButtonColor = false
                b.BackgroundColor3 = Library.Scheme.AccentColor
                b.BackgroundTransparency = 1
                b.BorderSizePixel = 0
                b.LayoutOrder = order
                b.Size = UDim2.new(1, 0, 0, wrapped and 0 or 18)
                b.AutomaticSize = wrapped and Enum.AutomaticSize.Y or Enum.AutomaticSize.None
                b.FontFace = Library.Scheme.Font
                b.Text = str
                b.TextColor3 = Library.Scheme.FontColor
                b.TextSize = 13
                b.TextWrapped = wrapped
                b.TextXAlignment = cfg.Alignment or Enum.TextXAlignment.Left
                b.TextYAlignment = cfg.TextYAlignment or Enum.TextYAlignment.Center
                b.TextTruncate = wrapped and Enum.TextTruncate.None or Enum.TextTruncate.AtEnd
                b.RichText = false
                b.Parent = scroll

                local bp = Instance.new("UIPadding")
                bp.PaddingLeft = UDim.new(0, 6)
                bp.PaddingRight = UDim.new(0, 6)
                bp.Parent = b

                local bc = Instance.new("UICorner")
                bc.CornerRadius = UDim.new(0, 4)
                bc.Parent = b

                if selectable then
                    b.MouseEnter:Connect(function()
                        if not isSelected(str) then b.TextColor3 = ACCENT_LIT end
                    end)
                    b.MouseLeave:Connect(function()
                        if not isSelected(str) then b.TextColor3 = Library.Scheme.FontColor end
                    end)
                    b.MouseButton1Click:Connect(function()
                        if w._disabled then return end
                        if multi then
                            w.Value = w.Value or {}
                            local found
                            for i, v in ipairs(w.Value) do
                                if v == str then found = i break end
                            end
                            if found then table.remove(w.Value, found) else table.insert(w.Value, str) end
                        else
                            w.Value = str
                        end
                        Chaos:_setFlag(w.Flag, w.Value)
                        paint()
                        safecall(cfg.Callback, w.Value)
                    end)
                end

                table.insert(rows, { Button = b, Value = str })
            end
        end
        paint()
    end

    if searchBox then
        searchBox:GetPropertyChangedSignal("Text"):Connect(rebuild)
    end

    function w:Refresh(items)
        self.Data = {}
        for i, v in ipairs(items or {}) do self.Data[i] = v end

        if self.Multi then
            local keep = {}
            for _, v in ipairs(self.Value or {}) do
                for _, it in ipairs(self.Data) do
                    if tostring(it) == v then table.insert(keep, v) break end
                end
            end
            self.Value = keep
        else
            local still = false
            for _, it in ipairs(self.Data) do
                if tostring(it) == self.Value then still = true break end
            end
            if not still then self.Value = nil end
        end
        rebuild()
    end

    function w:Set(value)
        self.Value = value
        Chaos:_setFlag(self.Flag, value)
        paint()
    end

    function w:Get() return self.Value end

    function w:_setDisabled(disabled)
        self._disabled = disabled and true or false
        scroll.BackgroundTransparency = self._disabled and 0.5 or 0
        if searchBox then
            searchBox.TextEditable = not self._disabled
            searchBox.TextTransparency = self._disabled and 0.5 or 0
        end
        for _, row in ipairs(rows) do
            row.Button.TextTransparency = self._disabled and 0.5 or 0
        end
    end

    w:Refresh(cfg.Items or {})
    Chaos:_setFlag(cfg.Flag, w.Value)
    Chaos:_registerDepend(w, cfg.DependsOn)
    pcall(function() self.Box:Resize() end)
    return w
end

