function SectionProto:Keybind(cfg)
    cfg = cfg or {}
    -- Obsidian keypickers hang off a label/toggle, so give it a host label
    local label = self.Box:AddLabel(tostring(cfg.Name or "keybind"))
    local kw
    local picker = label:AddKeyPicker(uid(cfg.Flag), {
        Text    = tostring(cfg.Name or "keybind"),
        Default = keyString(cfg.Default),
        Mode    = cfg.Mode or "Toggle",
        Callback = function(state)
            safecall(cfg.Callback, state)
        end,
    })
    kw = newWrapper(picker, cfg)
    function kw:Set(key)
        pcall(function() self.Object:SetValue({ keyString(key), cfg.Mode or "Toggle" }) end)
    end
    Chaos:_setFlag(cfg.Flag, cfg.Default)
    return kw
end

