--==================================================================
-- DROPDOWN
--==================================================================
function SectionProto:Dropdown(cfg)
    cfg = cfg or {}
    local idx = uid(cfg.Flag)
    local multi = cfg.Multi and true or false
    local w

    local values = {}
    for i, v in ipairs(cfg.Items or {}) do values[i] = v end

    local dropdown = self.Box:AddDropdown(idx, {
        Text       = tostring(cfg.Name or "dropdown"),
        Values     = values,
        Default    = cfg.Default,
        Multi      = multi,
        Searchable = (#values > 8) or (cfg.Search and true or false),
        AllowNull  = not cfg.Required,
        MaxVisibleDropdownItems = math.max(3, math.floor((tonumber(cfg.MaxHeight) or 170) / 22)),
        Tooltip    = cfg.Tooltip,
        Callback   = function(value)
            if not w then return end
            guarded(w, cfg.Callback or function() end, multi and multiToHybrid or nil)(value)
        end,
    })

    w = newWrapper(dropdown, cfg)
    w.Multi = multi

    function w:Set(value)
        if multi then
            self.Object:SetValue(value or {})
            return
        end
        -- clear when the value is gone from the list (script passes "None")
        if type(value) == "string" and not table.find(self.Object.Values, value) then
            self.Object:SetValue(nil)
            return
        end
        self.Object:SetValue(value)
    end

    function w:Refresh(items)
        local list = {}
        for i, v in ipairs(items or {}) do list[i] = v end
        self.Object:SetValues(list)
    end

    function w:Get() return self.Object.Value end

    Chaos:_setFlag(cfg.Flag, multi and multiToHybrid(dropdown.Value) or dropdown.Value)
    Chaos:_registerDepend(w, cfg.DependsOn)
    return w
end

