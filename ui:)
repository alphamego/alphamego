--==================================================================
-- TOGGLE
--==================================================================
function SectionProto:Toggle(cfg)
    cfg = cfg or {}
    local idx = uid(cfg.Flag)
    local w
    local toggle = self.Box:AddToggle(idx, {
        Text     = tostring(cfg.Name or "toggle"),
        Default  = cfg.Default and true or false,
        Tooltip  = cfg.Tooltip,
        Risky    = cfg.Risky,
        Callback = function(value)
            if w then guarded(w, cfg.Callback or function() end)(value) end
        end,
    })

    w = newWrapper(toggle, cfg)
    w.Section = self

    function w:Set(value)
        if self._inCallback then
            -- self-recursion from inside our own callback: just move the visual
            pcall(function() self.Object.Value = value and true or false end)
            pcall(function() self.Object:Display() end)
            Chaos:_setFlag(self.Flag, value and true or false)
            return
        end
        self.Object:SetValue(value and true or false)
    end
    function w:Get() return self.Object.Value end

    -- keybind attached to this toggle
    function w:Keybind(kcfg)
        kcfg = kcfg or {}
        local kw
        local picker = self.Object:AddKeyPicker(uid(kcfg.Flag), {
            Text     = tostring(kcfg.Name or self.Name or "keybind"),
            Default  = keyString(kcfg.Default),
            Mode     = kcfg.Mode or "Toggle",
            SyncToggleState = kcfg.SyncToggleState and true or false,
            NoUI     = false,
            Callback = function(state)
                if kw then kw._state = state end
                safecall(kcfg.Callback, state)
            end,
        })
        kw = newWrapper(picker, kcfg)
        function kw:Set(key)
            pcall(function() self.Object:SetValue({ keyString(key), kcfg.Mode or "Toggle" }) end)
        end
        function kw:Get() return self.Object.Value end

        -- the script calls SetMode() bare, right after writing .Toggled, to
        -- push the new state into the keybind display
        function kw:SetMode(mode)
            local obj = rawget(self, "Object")
            if type(mode) == "string" then
                pcall(function() obj:SetValue({ obj.Value, mode, obj.Modifiers }) end)
            else
                pcall(function() obj:Update() end)
            end
        end

        Chaos:_setFlag(kcfg.Flag, kcfg.Default)
        return kw
    end

    Chaos:_setFlag(cfg.Flag, toggle.Value)
    Chaos:_registerDepend(w, cfg.DependsOn)
    return w
end

